# Generate a strong key with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me-with-a-real-secret-key

# Set to True only during local development
DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres connection string, e.g. postgres://user:pass@host:5432/dbname
# Leave unset to fall back to a local SQLite file (dev only — not for
# production, SQLite does not handle concurrent writes from multiple
# gunicorn/RQ worker processes safely).
DATABASE_URL=

# Redis is required for the async ingestion job queue (Django-RQ) and for
# shared rate-limit counters across worker processes.
#
# The query params below matter for hosted/free-tier Redis (Upstash, Redis
# Cloud, etc.): those providers silently drop idle TCP connections, and
# without socket_timeout the worker's blocking dequeue can hang forever on
# a dead connection with no error, no crash, and no log line — jobs just
# sit in the queue until someone notices and restarts the worker by hand.
# socket_timeout bounds any single blocking call so a dead connection
# surfaces as a ConnectionError RQ automatically reconnects from instead.
# Safe to drop these params for a local (non-hosted) Redis if you prefer.
REDIS_URL=redis://127.0.0.1:6379/0?socket_timeout=30&socket_connect_timeout=10&socket_keepalive=true&retry_on_timeout=true&health_check_interval=30

# Field-level encryption key for stored data-source credentials (Postgres/
# Mongo/storage connections). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# This is app-level envelope encryption (Fernet/AES). Swap in a real KMS
# later by changing core/crypto.py's key retrieval only — the schema
# (an opaque encrypted TextField) doesn't need to change.
FIELD_ENCRYPTION_KEY=replace-me-with-a-generated-fernet-key

# Server keypair for browser-side transit encryption — the frontend fetches
# the public half from GET /api/crypto/public-key/ and encrypts connection
# credentials client-side (AES-256-GCM + RSA-OAEP) before they ever leave
# the browser; this key decrypts them server-side, once, right before
# they're re-encrypted at rest via FIELD_ENCRYPTION_KEY above. Generate with:
#   python -c "from cryptography.hazmat.primitives.asymmetric import rsa; from cryptography.hazmat.primitives import serialization; k = rsa.generate_private_key(public_exponent=65537, key_size=2048); print(k.private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption()).decode().replace(chr(10), '\\n'))"
TRANSIT_PRIVATE_KEY=replace-me-with-a-generated-rsa-private-key

# Comma-separated hostnames the SSRF egress guard should allow to resolve to
# private/internal IP ranges (e.g. a self-hosted DB on a trusted VPC/VPN).
# Leave empty to block all private/loopback/link-local/metadata addresses.
SSRF_ALLOWED_HOSTS=

# Max ingestion job-create requests per user per hour.
INGESTION_RATE_LIMIT=20/hour

# Max login/register attempts per IP — added after a production-readiness
# audit found these endpoints had no rate limiting at all.
AUTH_LOGIN_RATE_LIMIT=10/min
AUTH_REGISTER_RATE_LIMIT=10/hour

# Caps the ingestion-engine Node subprocess's V8 heap (MB) — a partial
# guard against a pathological schema/repo exhausting host memory. See
# ingestion/tasks.py for what this does and doesn't cover.
INGESTION_MAX_MEMORY_MB=512

# --- GitHub App -------------------------------------------------------------
# Leave all of these blank until you've completed the one-time operator setup:
# start the app, log in as any user, and visit
# GET /api/integrations/github/manifest/ — it returns a manifest + a small
# HTML auto-submitting form that creates the App on github.com for you. After
# GitHub redirects back, hit the callback it points at once to receive the
# App id/private key/secrets, then paste them below and restart the server.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=
# Where GitHub should send users back after creating/installing the App.
# Must be reachable by the browser doing the install (an ngrok/tunnel URL
# works fine for local dev).
GITHUB_APP_BASE_URL=http://localhost:8000

# --- Google OAuth ("Continue with Google") ----------------------------------
# From https://console.cloud.google.com → APIs & Services → Credentials →
# Create Credentials → OAuth client ID → Web application. Add an authorized
# redirect URI of {BACKEND_BASE_URL}/api/auth/google/callback/ (e.g.
# http://localhost:8000/api/auth/google/callback/ for local dev). "Continue
# with Google" returns 503 until both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# This backend's own public URL — only needed if it differs from
# GITHUB_APP_BASE_URL above (most deployments can leave this blank).
BACKEND_BASE_URL=

# Where the browser lands after "Continue with GitHub"/"Continue with
# Google" finishes.
FRONTEND_URL=http://localhost:5173
