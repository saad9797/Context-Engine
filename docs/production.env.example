# Template only. Store real values in your deployment secret manager.
DJANGO_SETTINGS_MODULE=core.production_settings
DJANGO_SECRET_KEY=GENERATE_A_NEW_SECRET_AT_LEAST_50_CHARACTERS_LONG
FIELD_ENCRYPTION_KEY=GENERATE_A_NEW_FERNET_KEY
TRANSIT_PRIVATE_KEY=GENERATE_A_NEW_RSA_PRIVATE_KEY_WITH_ESCAPED_NEWLINES
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/contexa?sslmode=require
REDIS_URL=rediss://USER:PASSWORD@REDIS_HOST:6380/0?socket_timeout=30&socket_connect_timeout=10
ALLOWED_HOSTS=api.example.com,127.0.0.1
BACKEND_BASE_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
INGESTION_RATE_LIMIT=20/hour
CONTEXT_PACK_RATE_LIMIT=60/hour
AUTH_LOGIN_RATE_LIMIT=10/min
AUTH_REGISTER_RATE_LIMIT=10/hour
INGESTION_MAX_MEMORY_MB=512
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_BASE_URL=https://api.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
