# ── Python / Django (Rest Saas backend) ─────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.sqlite3
*.db
*.log
.venv/
venv/
ENV/
env/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# ── Node / JS (frontend + ingestion engine) ─────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Secrets — never commit real credentials, only *.example templates ──────
.env
.env.local
.env.production
.env.*.local
!.env.example

# ── IDE / OS ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── Build outputs ────────────────────────────────────────────────────────────
build/
dist/
out/

# ── Local data / uploads generated at runtime ───────────────────────────────
media/
staticfiles/
uploads/

# ── Temporary files ──────────────────────────────────────────────────────────
tmp/
temp/
*.swp
*.swo

# ── Testing/automation artifacts ─────────────────────────────────────────────
.playwright-mcp/

# ── Real ingestion output dumps — may contain live schema/sample data from
#    a connected database; never appropriate to commit regardless of repo
#    visibility.
sample.json
*.ingestion-output.json

# Reproducible public research download cache (not training artifacts).
docs/training/public_cache/
